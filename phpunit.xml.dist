<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnRisky="true"
         failOnWarning="true"
>
    <!--
        A directory only picks up files whose name ends in Test.php, so tests/Fixtures and
        tests/TestCase.php stay out without an explicit exclude.
    -->
    <testsuites>
        <testsuite name="Package">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!--
            Filament registers its test macros only when the app is running unit tests, hence
            APP_ENV=testing. The locale is pinned because the suite asserts English literals.
        -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_LOCALE" value="en"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
</phpunit>
