includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - vendor/pestphp/pest-plugin-phpstan/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon

parameters:

    paths:
        - src
        - tests

    level: max

    # PHPStan analyses at the RUNTIME PHP version unless told otherwise, so the
    # single 8.5 job in `quality.yml` would verify nothing about the 8.4 floor.
    # Measured both ways with `phpstan diagnose`: without this block it prints
    # "PHP version for analysis: 8.5.9 (from runtime)" while already knowing
    # "PHP composer.json required version: 8.4-8.5.99"; with it, "8.4-8.5.99
    # (from config)".
    phpVersion:
        min: 80400
        max: 80599

    reportUnmatchedIgnoredErrors: true

    # The dev container is `--rm`, so the default result cache under the system temp
    # directory is thrown away on every run and every analysis starts cold. Resolved
    # relative to this file, so it lands in the bind mount and survives: 11.9s -> 1.6s.
    tmpDir: .cache/phpstan
